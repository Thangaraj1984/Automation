# =================================================================
# NSE Market Data Stack — Master Configuration Template
# =================================================================
#
# SETUP INSTRUCTIONS (read this first):
#   1. Copy this file:
#        Linux/macOS:  cp .env.example .env
#        Windows:      copy .env.example .env
#
#   2. Fill in every value marked with  YOUR_...
#      (lines without YOUR_... already have sensible defaults)
#
#   3. Update nginx/nsedata.conf — replace YOUR_DOMAIN with your domain
#      (one-time, done automatically if you run scripts/setup.sh)
#
#   4. Deploy:  docker compose up -d
#
# This ONE file is the single source of truth for the entire stack.
# All containers and scripts read their config from here.
# =================================================================


# ── IIFL Capital Markets API ─────────────────────────────────────
# Register at: https://developers.iiflcapital.com
# Your app credentials from the developer portal:
IIFL_APP_KEY=YOUR_IIFL_APP_KEY
IIFL_API_SECRET=YOUR_IIFL_API_SECRET
IIFL_CLIENT_ID=YOUR_IIFL_CLIENT_ID

# Auth code is obtained daily via browser login.
# Run:  python scripts/get_iifl_jwt.py  — it will update this automatically.
IIFL_AUTH_CODE=YOUR_DAILY_AUTH_CODE

# Session JWT token — auto-populated by get_iifl_jwt.py. Leave blank initially.
IIFL_SESSION_TOKEN=

# OAuth redirect URL registered with IIFL (must match exactly):
IIFL_AUTH_REDIRECT=https://nsedata.YOUR_DOMAIN/auth/callback

# ── Database (TimescaleDB) ────────────────────────────────────────
# nseadmin is fine as the username; choose a strong password.
DB_USER=nseadmin
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
DB_NAME=nse_market_data

# ── Deployment Domain ─────────────────────────────────────────────
# The subdomain you'll create for the NSE data API.
# Example: if your domain is example.com, set:  nsedata.example.com
# You also need to:
#   - Create a DNS A record: nsedata.YOUR_DOMAIN → YOUR_VM_IP
#   - Update nginx/nsedata.conf with this domain
DOMAIN=nsedata.YOUR_DOMAIN

# ── API Security ──────────────────────────────────────────────────
# DATA_API_KEY: random string used by external consumers (Excel, Sheets, etc.)
# Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
DATA_API_KEY=YOUR_RANDOM_API_KEY_HERE

# PIN to protect the /auth page (prevents unauthorized token refresh)
AUTH_PAGE_PIN=1234

# ── VM / Deployment Target ────────────────────────────────────────
# Your Azure (or any Linux) VM details:
VM_IP=YOUR_VM_PUBLIC_IP
VM_USER=azureuser
VM_ENV_FILE=/home/azureuser/nse-market-data/.env

# Path to your SSH private key (used by update_auth scripts):
SSH_KEY=~/.ssh/id_rsa

# ── Market Data Subscription ──────────────────────────────────────
# Which instrument to track (NIFTY or BANKNIFTY)
SUBSCRIPTION_SYMBOL=NIFTY
SUBSCRIPTION_SEGMENT=NSEFO

# How many strikes above/below ATM to subscribe to
STRIKE_RANGE=20

# ── Backfill ──────────────────────────────────────────────────────
# Set ENABLE_BACKFILL=true on first run to seed historical OHLCV data
ENABLE_BACKFILL=false
BACKFILL_DAYS=30

# ── Ingestor Performance Tuning ───────────────────────────────────
# How often (seconds) to poll OI via REST API as a fallback
OI_POLL_INTERVAL=180

# Batch write settings — lower values = more real-time, higher CPU
BATCH_SIZE=100
BATCH_FLUSH_INTERVAL=0.5

# ── Data Quality / Safety Checks ─────────────────────────────────
# Drop ticks where LTP jumps more than N% from previous tick
LTP_SANITY_ENABLED=true
LTP_SANITY_THRESHOLD_PCT=200.0

# Drop ticks from instruments not in the instruments master table
DROP_UNKNOWN_TICKS=true
